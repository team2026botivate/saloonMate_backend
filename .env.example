GOOGLE_DRIVE_CREDENTIALS # Single-line JSON or relative/absolute path to the service account JSON
# Example (single-line JSON, keep \n in private_key):
# GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n","client_email":"svc@project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Alternatively, provide base64-encoded JSON (preferred for reliability). If set, this takes precedence:
GOOGLE_DRIVE_CREDENTIALS_BASE64

# Optional: Google Drive default folder for uploads
GOOGLE_DRIVE_FOLDER_ID

# Optional: enable auth loader debug logging (prints first 100 chars only)
DEBUG_GOOGLE_AUTH=false